Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: camera_init
    Background Color: 25; 28; 31
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 metre)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/PointCloud2
      Name: P9 accumulated geometry
      Enabled: true
      Topic:
        Value: /p9/map
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Path
      Name: P9 IMU-origin path
      Enabled: true
      Topic:
        Value: /p9/path
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
      Color: 255; 170; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Name: Local planned path (vehicle)
      Enabled: true
      Topic:
        Value: /path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Color: 255; 0; 255
      Line Width: 0.04
    - Class: rviz_default_plugins/Odometry
      Name: Body pose
      Enabled: true
      Topic:
        Value: /state_estimation
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
      Keep: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic: /p9/navigation/goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Pitch: 1.3
      Yaw: 0
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry: {Width: 1400, Height: 950}
