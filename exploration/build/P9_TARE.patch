+void SensorCoveragePlanner3D::PublishP9Diagnostics(
+    int candidate_viewpoints, int uncovered_surface_points,
+    int uncovered_frontier_points) {
+  // These are the planner's actual state and this iteration's coverage counts,
+  // not ground-truth coverage percentages or a motion completion certificate.
+  const double distance = GetRobotToHomeDistance();
+  std::ostringstream json;
+  json.imbue(std::locale::classic());
+  json << std::setprecision(17) << std::boolalpha
+       << "{\"sim_stamp\":" << this->now().seconds()
+       << ",\"candidate_viewpoints\":" << candidate_viewpoints
+       << ",\"uncovered_surface_points\":" << uncovered_surface_points
+       << ",\"uncovered_frontier_points\":" << uncovered_frontier_points
+       << ",\"exploration_finished\":" << exploration_finished_
+       << ",\"returned_home\":" << (exploration_finished_ && at_home_)
+       << ",\"stopped\":" << stopped_
+       << ",\"robot_to_home_distance\":";
+  if (std::isfinite(distance)) {
+    json << distance;
+  } else {
+    json << "null";
+  }
+  json << "}";
+  std_msgs::msg::String message;
+  message.data = json.str();
+  p9_diagnostics_pub_->publish(message);
+}
