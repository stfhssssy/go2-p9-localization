# Experimental AMD64 Gazebo bundle. It is not a Jetson / real-robot deployment.
ARG BASE_IMAGE=go2-p9-nav:amd64-20261110
FROM ${BASE_IMAGE}
ARG BASE_IMAGE_ID=unrecorded
ARG TARE_COMMIT=b6760adb4280b379567c76f4e684ce628e28ef71
ARG TARE_PATCH_SHA256=5510c3bede38690948eeaccca185e9f3b6051735555708de509669fc0b407b7b
ARG BUILD_JOBS=2
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
# /ws supplies compiled CHAMP/model packages; these binary runtime dependencies
# must already be present in the verified AMD64 navigation/simulation base.
RUN set -eo pipefail; \
    source /opt/ros/jazzy/setup.bash; \
    for p9_required_package in ros_gz_sim ros_gz_bridge gz_ros2_control xacro \
        robot_state_publisher controller_manager joint_state_broadcaster joint_trajectory_controller; do \
      ros2 pkg prefix "$p9_required_package" >/dev/null || \
        { echo "Missing simulation dependency in BASE_IMAGE: $p9_required_package" >&2; exit 1; }; \
    done
RUN test "$(dpkg --print-architecture)" = amd64 && \
    test -f /opt/p9/config/p9nav-sim.yaml && \
    test -f /opt/p9/simulation/inside.sh && \
    apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates build-essential cmake python3-colcon-common-extensions \
      python3-numpy python3-scipy python3-yaml python3-pil \
      libeigen3-dev libpcl-dev ros-jazzy-pcl-ros ros-jazzy-pcl-conversions \
      ros-jazzy-tf2-geometry-msgs ros-jazzy-visualization-msgs ros-jazzy-rviz2 \
      xvfb x11-utils fluxbox x11vnc novnc websockify ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY P9_TARE.patch /opt/p9-exploration/P9_TARE.patch
RUN set -eo pipefail; \
    printf '%s  %s\n' "$TARE_PATCH_SHA256" /opt/p9-exploration/P9_TARE.patch | sha256sum -c -; \
    git clone --no-checkout https://github.com/caochao39/tare_planner.git /tare_ws; \
    cd /tare_ws; git checkout --detach "$TARE_COMMIT"; \
    test "$(git rev-parse HEAD)" = "$TARE_COMMIT"; \
    git apply --check /opt/p9-exploration/P9_TARE.patch; \
    git apply /opt/p9-exploration/P9_TARE.patch; git diff --check; \
    mkdir -p /opt/p9-exploration/provenance; \
    git rev-parse HEAD > /opt/p9-exploration/provenance/tare-commit.txt; \
    git diff --binary > /opt/p9-exploration/provenance/applied-tare.patch; \
    printf '%s\n' "$BASE_IMAGE_ID" > /opt/p9-exploration/provenance/base-image-id.txt
RUN set -eo pipefail; \
    source /opt/ros/jazzy/setup.bash; source /opt/p9_ws/install/setup.bash; \
    cd /tare_ws; \
    MAKEFLAGS="-j${BUILD_JOBS}" CMAKE_BUILD_PARALLEL_LEVEL="$BUILD_JOBS" \
      colcon build --executor sequential --event-handlers console_direct+ \
      --packages-select tare_planner --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF; \
    source /tare_ws/install/local_setup.bash; \
    export LD_LIBRARY_PATH="/tare_ws/src/tare_planner/or-tools/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; \
    ldd /tare_ws/install/tare_planner/lib/tare_planner/tare_planner_node \
      > /opt/p9-exploration/provenance/tare-linkage.txt; \
    if grep -q 'not found' /opt/p9-exploration/provenance/tare-linkage.txt; then \
      cat /opt/p9-exploration/provenance/tare-linkage.txt; exit 1; fi; \
    sha256sum /tare_ws/install/tare_planner/lib/tare_planner/tare_planner_node \
      > /opt/p9-exploration/provenance/tare-binary.sha256

# /output/integration is a writable per-experiment copy made by run_container.sh.
# /ws is the existing compiled Gazebo/CHAMP workspace, mounted read-only at runtime.
COPY boundary.py capture_video.py exploration.json exploration.launch.py exploration.rviz exploration.sdf \
     guard_core.py guard_node.py inside.sh make_config.py make_scene.py observe_exploration.py \
     run_exploration.py test_guard_core.py test_observe_exploration.py \
     apply_mapping_patch.py test_mapping_points.py mapping-points.patch probe_latency.py probe_paths.py \
     README.md RESULTS.md Dockerfile.exploration build_exploration.sh run_container.sh /opt/p9-exploration/
RUN set -eo pipefail; \
    chmod 755 /opt/p9-exploration/inside.sh /opt/p9-exploration/run_exploration.py; \
    python3 /opt/p9-exploration/test_mapping_points.py \
      --source /opt/p9_ws/src/go2_p9/go2_p9/mapping_core.py \
      | tee /opt/p9-exploration/provenance/mapping-equivalence.json; \
    python3 /opt/p9-exploration/apply_mapping_patch.py \
      --provenance /opt/p9-exploration/provenance/mapping; \
    python3 /opt/p9-exploration/test_guard_core.py; \
    python3 /opt/p9-exploration/test_observe_exploration.py; \
    python3 -c 'from PIL import features; assert features.check_feature("xcb"), "Pillow XCB capture is required"'; \
    find /opt/p9-exploration -maxdepth 1 -type f -print0 | sort -z | xargs -0 sha256sum \
      > /opt/p9-exploration/provenance/integration-files.sha256; \
    dpkg-query -W > /opt/p9-exploration/provenance/packages.txt
LABEL org.opencontainers.image.title="P9 + TARE experimental Gazebo exploration" \
      org.opencontainers.image.source="https://github.com/caochao39/tare_planner" \
      org.opencontainers.image.revision="b6760adb4280b379567c76f4e684ce628e28ef71" \
      p9.base_image_id="${BASE_IMAGE_ID}"
WORKDIR /output
ENTRYPOINT ["/usr/local/bin/p9-entrypoint"]
CMD ["bash", "-c", "echo 'Use run_container.sh with a NEW output directory and the existing compiled /ws simulation workspace.'; exit 2"]
